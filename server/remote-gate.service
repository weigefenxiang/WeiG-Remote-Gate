[Unit]
Description=WeiG Remote Gate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remotegate
Group=remotegate
WorkingDirectory=/usr/local/lib/remote-gate
ExecStart=/usr/bin/python3 /usr/local/lib/remote-gate/profile-entry.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/remote-gate
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
