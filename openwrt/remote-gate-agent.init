#!/bin/sh /etc/rc.common

START=96
STOP=10

AGENT_BIN="/usr/lib/remote-gate/remote-gate-agent.sh"
RETURN_BIN="/etc/hotplug.d/iface/95-remote-gate"
AGENT_PID="/var/run/remote-gate-agent.pid"
RETURN_PID="/var/run/remote-gate-return-route.pid"
AGENT_INTERVAL="${REMOTE_GATE_AGENT_INTERVAL:-5}"
case "$AGENT_INTERVAL" in ''|*[!0-9]*) AGENT_INTERVAL=5 ;; esac
[ "$AGENT_INTERVAL" -ge 5 ] || AGENT_INTERVAL=5
export AGENT_INTERVAL

# Modern OpenWrt/LEDE/ImmortalWrt uses procd. Keep a small rc.common PID
# fallback for older compatible derivatives instead of rejecting them only
# because procd is unavailable.
if [ -x /sbin/procd ] || command -v procd >/dev/null 2>&1; then
    USE_PROCD=1
fi

pid_owned() {
    pidfile="$1"
    marker="$2"
    [ -r "$pidfile" ] || return 1
    pid="$(sed -n '1p' "$pidfile" 2>/dev/null || true)"
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ -r "/proc/$pid/cmdline" ] || return 1
    tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -Fq "$marker"
}

legacy_start_one() {
    pidfile="$1"
    marker="$2"
    shift 2
    pid_owned "$pidfile" "$marker" && return 0
    rm -f "$pidfile"
    "$@" >/dev/null 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$pidfile"
    chmod 600 "$pidfile" 2>/dev/null || true
    sleep 1
    if ! pid_owned "$pidfile" "$marker"; then
        rm -f "$pidfile"
        return 1
    fi
}

legacy_stop_one() {
    pidfile="$1"
    marker="$2"
    if pid_owned "$pidfile" "$marker"; then
        pid="$(sed -n '1p' "$pidfile")"
        kill "$pid" 2>/dev/null || true
        count=0
        while pid_owned "$pidfile" "$marker" && [ "$count" -lt 5 ]; do
            sleep 1
            count=$((count + 1))
        done
        pid_owned "$pidfile" "$marker" && kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$pidfile"
}

clear_return_routes() {
    [ -x "$RETURN_BIN" ] || return 0
    "$RETURN_BIN" return-route-clear >/dev/null 2>&1 || true
}

start_service() {
    procd_open_instance agent
    procd_set_param command "$AGENT_BIN" loop
    procd_set_param env AGENT_INTERVAL="$AGENT_INTERVAL"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance return-route
    procd_set_param command "$RETURN_BIN" return-route-loop
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    clear_return_routes
}

# rc.common fallback used only when USE_PROCD is not enabled.
start() {
    [ -x "$AGENT_BIN" ] || return 1
    [ -x "$RETURN_BIN" ] || return 1
    legacy_start_one "$AGENT_PID" 'remote-gate-agent.sh' "$AGENT_BIN" loop || return 1
    if ! legacy_start_one "$RETURN_PID" '95-remote-gate' "$RETURN_BIN" return-route-loop; then
        legacy_stop_one "$AGENT_PID" 'remote-gate-agent.sh'
        return 1
    fi
}

stop() {
    legacy_stop_one "$RETURN_PID" '95-remote-gate'
    legacy_stop_one "$AGENT_PID" 'remote-gate-agent.sh'
    clear_return_routes
}
