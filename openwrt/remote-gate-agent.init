#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance agent
    procd_set_param command /usr/lib/remote-gate/remote-gate-agent.sh loop
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance return-route
    procd_set_param command /etc/hotplug.d/iface/95-remote-gate return-route-loop
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    [ -x /etc/hotplug.d/iface/95-remote-gate ] || return 0
    /etc/hotplug.d/iface/95-remote-gate return-route-clear >/dev/null 2>&1 || true
}
